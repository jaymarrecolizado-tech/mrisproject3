# DICT MRIS — Environment Configuration Example
# Copy this to .env and adjust for your environment
# NEVER commit the actual .env file to version control

# JWT
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-strong-random-secret-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=dict-mris
JWT_AUDIENCE=dict-mris-app
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dict_mris
# Create dedicated user: mysql -u root -p < database/setup-app-user.sql
# Then set DB_USER=dict_mris_app and DB_PASS=<your-strong-password>
DB_USER=dict_mris_app
DB_PASS=replace-with-strong-password

# CORS (comma-separated if multiple origins; NEVER use * in production)
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
# For local dev only — replace before deploying
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Application URL (used for password reset links)
APP_URL=http://localhost:5173