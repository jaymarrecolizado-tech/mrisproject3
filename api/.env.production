# DICT MRIS — Production Environment Configuration
# Copy this to .env on production server and adjust all values

# JWT (REQUIRED - generate with: php -r "echo base64_encode(random_bytes(32)) . PHP_EOL;")
JWT_SECRET=GENERATE_NEW_STRONG_SECRET_FOR_PRODUCTION
JWT_EXPIRY=86400

# Database (REQUIRED - run database/setup-app-user.sql on MySQL first)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dict_mris
DB_USER=dict_mris_app
DB_PASS=GENERATE_STRONG_DB_PASSWORD_AND_UPDATE_HERE

# CORS (REQUIRED - replace with your actual production domain(s), NEVER use *)
# Format: comma-separated list, e.g., https://mris.dict.gov.ph,https://www.mris.dict.gov.ph
CORS_ORIGIN=https://your-production-domain.com

# Optional: PHP settings for production
# PHP_INI_SCAN_DIR=/path/to/php.ini